bin/
coverage.out
data/
*.log
.dev/
# 本地构建缓存（沙箱环境把 GOCACHE/GOPATH 重定向到工作区内时使用）
.go-cache/
.go-gopath/

# buildx 缓存（BUILDX_CONFIG 重定向目录，构建噪音非密钥，但勿入库）
.data/
# 本地环境变量（含宿主工作区绝对路径 WORKSPACE 与钉钉 webhook，禁止入库）
.env
.env.local

# 一次性数据清理快照（2026-11-03，仅本机留档，勿入库；不删除文件本身）
.data-cleanup-manifest.txt

# Python 工具脚本（scripts/ 与 deploy/）的字节码缓存
__pycache__/
*.pyc

# 前端
web/node_modules/
web/.angular/
web/dist/
web/out-tsc/
# embed 源（internal/web/dist/browser）：构建产物忽略，保留 .gitkeep 以便 go build 的 embed 路径始终存在
internal/web/dist/browser/*
!internal/web/dist/browser/.gitkeep
mcp/node_modules/
# web 走 pnpm，唯一依赖真相源是 web/pnpm-lock.yaml。Makefile 的 PM 会在没装 pnpm
# 时回退 npm 并生成 web/package-lock.json；那份不入库（同一个 package.json 挂两份
# 锁文件，改依赖时极易只刷新一份而静默漂移）。本机 ~/.gitignore_global 也有全局
# `package-lock.json` 规则，但那只在本机生效——这里写成仓库级规则，保证协作者
# 克隆后行为一致；锁与 package.json 是否同步由 `make web-lock-check` 校验。
web/package-lock.json
# mcp/package-lock.json 已跟踪，是 MCP 桥依赖的确定性来源；若用户级
# ~/.gitignore_global 里有 `package-lock.json` 规则，它会被判为「已忽略但已跟踪」，
# 协作时容易出现 add -f / 误删后加不回来的坑。仓库级 .gitignore 优先级高于
# core.excludesFile，这里显式取反放行（只放行这一个，其余 package-lock 仍忽略）。
!mcp/package-lock.json

# npm config (may contain registry auth tokens; keep local only)
.npmrc
web/.fakehome/

# 个人供应商运维清单（含个人路由策略/优先级细节，2026-11-15 用户决定 local only；
# 文件已 git rm --cached 移出跟踪——勿删此规则，否则下次 git add -A 会把真实清单带回公开仓）
docs/providers-inventory.zh.md
