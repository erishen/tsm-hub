{
  "uid": "tsm-hub-overview",
  "title": "tsm-hub 网关监控",
  "description": "LLM 网关 /metrics 总览。除原有 7 个指标外，复用 quota.Recorder / Tracker.Snapshot() / MCPStatuses() / AdminOverview() 等已有内存聚合，新增用量成本、健康状态机、MCP/A2A、配置与运行时面板；底部另有 Alertmanager 与钉钉通知链路自监控。延迟仍是 EWMA gauge（无 p95/p99）。所有标签均为代码内有限枚举或已配置的 provider ID，不含任何密钥、URL、ID。数据源由 provisioning 自动注册。",
  "tags": ["tsm-hub", "llm-gateway", "monitoring", "alerting"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "links": [
    { "title": "Prometheus 告警", "url": "http://127.0.0.1:19092/alerts", "type": "link", "icon": "external link", "targetBlank": true },
    { "title": "Prometheus Targets", "url": "http://127.0.0.1:19092/targets", "type": "link", "icon": "external link", "targetBlank": true },
    { "title": "Alertmanager（告警/静默）", "url": "http://127.0.0.1:19093", "type": "link", "icon": "external link", "targetBlank": true }
  ],
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(tsm_hub_upstream_healthy, provider)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(tsm_hub_upstream_healthy, provider)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "regex": "",
        "skipUrlSync": false,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": []
      },
      {
        "name": "scene",
        "label": "Scene",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(tsm_hub_usage_scene_requests_total, scene)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(tsm_hub_usage_scene_requests_total, scene)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "regex": "",
        "skipUrlSync": false,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": []
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "监控抓取状态 (up)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "up{job=\"tsm-hub\"}", "legendFormat": "up" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "进程运行时长",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "tsm_hub_uptime_seconds", "legendFormat": "uptime" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "网关请求速率 (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(rate(tsm_hub_http_requests_total[5m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "上游整体错误率 (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.3 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(rate(tsm_hub_upstream_errors_total{provider=~\"$provider\"}[5m])) / clamp_min(sum(rate(tsm_hub_upstream_requests_total{provider=~\"$provider\"}[5m])), 0.001)", "legendFormat": "error rate" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "健康 Provider 比例",
      "description": "健康的 provider 数 / 当前 provider 总数。旧版只显示绝对数，1/15 健康也会是绿灯。",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.6 }, { "color": "green", "value": 0.9 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(tsm_hub_upstream_healthy{provider=~\"$provider\"}) / clamp_min(count(tsm_hub_upstream_healthy{provider=~\"$provider\"}), 1)", "legendFormat": "healthy ratio" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "触发中的告警数",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "firing" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "上游错误率 by provider (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (rate(tsm_hub_upstream_errors_total{provider=~\"$provider\"}[5m])) / clamp_min(sum by (provider) (rate(tsm_hub_upstream_requests_total{provider=~\"$provider\"}[5m])), 0.001)", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "上游请求速率 by provider (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (rate(tsm_hub_upstream_requests_total{provider=~\"$provider\"}[5m]))", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "上游延迟 EWMA (ms)",
      "description": "网关只暴露 EWMA gauge，没有直方图，算不了 p95/p99。EWMA 仅在上游成功时更新；health.go 已加 15 分钟惰性 TTL，超过 15m 无成功请求即导出 0，不会再像 2026-11-14 之前那样挂着 10 天前的 58185ms。配套告警另有「近 15m 有成功样本」门控做双保险。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "tsm_hub_upstream_latency_ms{provider=~\"$provider\"}", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP 状态码速率 by status (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(tsm_hub_http_requests_total[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Provider 健康状态 (1=可用, 0=摘除)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "tsm_hub_upstream_healthy{provider=~\"$provider\"}", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "配额/限流拒绝 (5m 增量)",
      "description": "/metrics 在无拒绝记录时不输出 quota_denials 样本，用 or vector(0) 兜底显示 0，避免面板长期空白。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 50, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum(increase(tsm_hub_quota_denials_total[5m])) or vector(0)", "legendFormat": "denials" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "触发中的告警 (来自 prometheus.rules.yml)",
      "description": "值为 1 表示该告警正在 firing；没有告警时此面板为空属正常。",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "legendFormat": "{{alertname}} · {{provider}}" }]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Token 消耗 by provider (1h 增量)",
      "description": "来自 quota.Recorder 的累计计数（启动时由 data/usage/*.jsonl 回放，重启不清零），用 increase() 看增量。prompt + completion 按 provider 合并。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (increase(tsm_hub_usage_tokens_total{provider=~\"$provider\"}[1h]))", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "累计成本 (USD) by provider",
      "description": "quota.Recorder 的估算成本累计值，单独看 24h 窗口；汇率/单价来自配置里的 pricing，是估算不是账单。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "timeFrom": "24h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "min": 0, "decimals": 4, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (tsm_hub_usage_cost_usd_total{provider=~\"$provider\"})", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "上游冷却剩余 (s)",
      "description": "Tracker.Snapshot() 中 down_until / throttle_until 取较晚者减当前时间；0 表示不在冷却。配合 TSMHubProviderUnhealthy 判断何时会恢复。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "tsm_hub_upstream_cooldown_remaining_seconds{provider=~\"$provider\"}", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "半开态与连续失败",
      "description": "半开态取 1/0；连续失败是带 TTL 的有效失败计数（过期自动归零）。可看出 provider 是在冷却、探测中还是刚恢复。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "tsm_hub_upstream_half_open{provider=~\"$provider\"}", "legendFormat": "半开 {{provider}}" },
        { "refId": "B", "expr": "tsm_hub_upstream_consecutive_failures{provider=~\"$provider\"}", "legendFormat": "失败 {{provider}}" }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "场景请求速率与工具调用来源",
      "description": "场景只保留 chat/reason/code/fast/other 五类，工具只按 builtin/skill/mcp 三类汇总；任何具体工具名、模型名都不会进标签。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (scene) (rate(tsm_hub_usage_scene_requests_total{scene=~\"$scene\"}[5m]))", "legendFormat": "场景 {{scene}}" },
        { "refId": "B", "expr": "sum by (source) (rate(tsm_hub_tool_calls_total[5m]))", "legendFormat": "工具 {{source}}" }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "MCP / A2A 快照",
      "description": "MCP 只导连接/断开数量与工具总数（不导 server 名），A2A 只导活跃任务数与能力数（不导 task ID、节点名）。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "tsm_hub_mcp_servers", "legendFormat": "MCP {{state}}" },
        { "refId": "B", "expr": "tsm_hub_a2a_tasks_active", "legendFormat": "A2A 活跃任务" },
        { "refId": "C", "expr": "tsm_hub_a2a_capabilities", "legendFormat": "A2A 能力" }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Go 运行时与配置实体",
      "description": "goroutines 与堆内存用于发现长驻 SSE / MCP 子进程泄漏；配置实体数突变可当变更检测。",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "tsm_hub_runtime_goroutines", "legendFormat": "goroutines" },
        { "refId": "B", "expr": "tsm_hub_runtime_heap_alloc_bytes", "legendFormat": "heap alloc (bytes)" },
        { "refId": "C", "expr": "tsm_hub_config_entities", "legendFormat": "配置 {{entity}}" }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Alertmanager 在线 (up)",
      "description": "来自 prometheus.yml 的 alertmanager 自监控 job。or vector(0) 让 target 未注册时显示 0 而不是空白；为 0 时告警规则仍在 Prometheus 侧 firing，但通知送不出去。",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"alertmanager\"} or vector(0))", "legendFormat": "up" }]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "钉钉通知投递失败 (10m)",
      "description": "Alertmanager 的 webhook 集成失败计数。非 0 通常是加签密钥过期、群机器人被删、关键词不匹配或桥接器返回 5xx；查 tsm-hub-dingtalk-bridge 日志（URL 已脱敏）。",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(increase(alertmanager_notifications_failed_total[10m]) or vector(0))", "legendFormat": "failed" }]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Alertmanager 活跃告警",
      "description": "alertmanager_alerts 是 AM 当前持有的告警数（含已被 group_by 合并/抑制的）。配合顶部「触发中的告警数」可看出抑制是否生效。",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(alertmanager_alerts or vector(0))", "legendFormat": "alerts" }]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "生效中的静默",
      "description": "Alertmanager UI 里创建的静默数量。维护窗口期间把数值调大属预期；排查「告警没发」时先看这里。",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(alertmanager_silences{state=\"active\"} or vector(0))", "legendFormat": "silences" }]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "通知投递与规则 firing (10m 增量)",
      "description": "成功/失败是 Alertmanager webhook 集成计数，firing 是 Prometheus 规则数。三条线背离（firing 上升但成功线不动）说明通知链路断了；自指告警此时也送不出去，只能靠本面板发现。",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 70 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(alertmanager_notifications_total[10m]) or vector(0))", "legendFormat": "投递成功" },
        { "refId": "B", "expr": "sum(increase(alertmanager_notifications_failed_total[10m]) or vector(0))", "legendFormat": "投递失败" },
        { "refId": "C", "expr": "sum(count(ALERTS{alertstate=\"firing\"}) or vector(0))", "legendFormat": "规则 firing" }
      ]
    }
  ]
}
