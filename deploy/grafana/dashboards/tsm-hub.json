{
  "uid": "tsm-hub-overview",
  "title": "tsm-hub 网关监控",
  "description": "LLM 网关 /metrics 指标总览：请求速率、上游错误率与健康、延迟 EWMA、配额拒绝。数据源由 provisioning 自动注册。",
  "tags": ["tsm-hub", "llm-gateway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "进程运行时长",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "tsm_hub_uptime_seconds", "legendFormat": "uptime" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "网关请求速率 (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(rate(tsm_hub_http_requests_total[5m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "上游整体错误率 (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.3 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(rate(tsm_hub_upstream_errors_total[5m])) / clamp_min(sum(rate(tsm_hub_upstream_requests_total[5m])), 0.001)", "legendFormat": "error rate" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "健康 Provider 数",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "sum(tsm_hub_upstream_healthy)", "legendFormat": "healthy" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "上游错误率 by provider (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (rate(tsm_hub_upstream_errors_total[5m])) / clamp_min(sum by (provider) (rate(tsm_hub_upstream_requests_total[5m])), 0.001)", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "上游请求速率 by provider (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (rate(tsm_hub_upstream_requests_total[5m]))", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "上游延迟 EWMA (ms)",
      "description": "注意：网关目前只暴露 EWMA gauge，没有直方图，无法计算 p95/p99。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "tsm_hub_upstream_latency_ms", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP 状态码速率 by status (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(tsm_hub_http_requests_total[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Provider 健康状态 (1=可用, 0=摘除)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1, "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "tsm_hub_upstream_healthy", "legendFormat": "{{provider}}" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "配额/限流拒绝次数 (5m 增量)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 50, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (code) (increase(tsm_hub_quota_denials_total[5m]))", "legendFormat": "{{code}}" }]
    }
  ]
}
