# tsm-hub 环境变量配置示例
# 复制此文件为 .env 并修改为你的实际配置
# 优先级：命令行 flag > 环境变量 > .env 文件 > data/config.json

# ===== 基础配置 =====
# 监听地址
TSM_HUB_ADDR=:9070
# 数据目录
TSM_HUB_DATA_DIR=./data
# 管理口令（也可在 config.json 中配置）
TSM_HUB_ADMIN_TOKEN=your-admin-token
# 日志级别：debug|info|warn|error
TSM_HUB_LOG_LEVEL=info

# ===== 智能路由策略 =====
# 策略模式：cost_first / stability_first / task_aware / balanced
# - cost_first: 成本优先，免费/低价优先
# - stability_first: 稳定性优先，成功率高的 Provider 优先
# - task_aware: 任务感知，根据任务类型选择合适的模型
# - balanced: 平衡模式，综合考虑所有维度
TSM_HUB_SMART_STRATEGY=stability_first

# 各维度权重（0-200，0表示用该策略模式的内置权重）
TSM_HUB_SMART_COST_WEIGHT=50
TSM_HUB_SMART_STABILITY_WEIGHT=100
TSM_HUB_SMART_LATENCY_WEIGHT=70

# ===== 上游 Provider API Keys（可选） =====
# 密钥配置方式：管理后台（写入 config.json）或环境变量（.env / 系统环境变量）
# .env 文件适合本地开发，通常不会被提交到代码库；生产环境建议用系统环境变量注入
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# ===== 兼容旧前缀（不推荐，仅用于迁移） =====
# LLM_ROUTER_ADDR=:9070
# LLM_ROUTER_ADMIN_TOKEN=your-admin-token
