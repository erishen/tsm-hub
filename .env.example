# tsm-hub 环境变量配置示例
# 复制此文件为 .env 并修改为你的实际配置
# 优先级：命令行 flag > 环境变量 > .env 文件 > data/config.json

# ===== 基础配置 =====
# 监听地址
TSM_HUB_ADDR=:9070
# 数据目录
TSM_HUB_DATA_DIR=./data
# 管理口令（也可在 config.json 中配置）
TSM_HUB_ADMIN_TOKEN=your-admin-token
# 日志级别：debug|info|warn|error
TSM_HUB_LOG_LEVEL=info

# ===== fs MCP 挂载的宿主工作区根目录 =====
# mcp-fs 服务会把该目录只读挂载进容器，并作为 filesystem MCP 的根路径；
# 请改为你本机实际路径（例如 $HOME/workspace 或 /Users/<user>/projects）。
# 仅本地使用：.env 已被 .gitignore 忽略，不会进入代码库。
WORKSPACE=/path/to/your/workspace

# ===== 智能路由策略 =====
# 策略模式：cost_first / stability_first / task_aware / balanced
# - cost_first: 成本优先，免费/低价优先
# - stability_first: 稳定性优先，成功率高的 Provider 优先
# - task_aware: 任务感知，根据任务类型选择合适的模型
# - balanced: 平衡模式，综合考虑所有维度
TSM_HUB_SMART_STRATEGY=stability_first

# 各维度权重（0-200，0表示用该策略模式的内置权重）
TSM_HUB_SMART_COST_WEIGHT=50
TSM_HUB_SMART_STABILITY_WEIGHT=100
TSM_HUB_SMART_LATENCY_WEIGHT=70

# ===== 上游 Provider API Keys（可选） =====
# 密钥配置方式：管理后台（写入 config.json）或环境变量（.env / 系统环境变量）
# .env 文件适合本地开发，通常不会被提交到代码库；生产环境建议用系统环境变量注入
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# ===== A2A / Peer 接入 lume 集群（可选，不配则 peer 签名面 fail-closed） =====
# tsm-hub 作为能力节点接入 lume-a2a 协议：
#   GET  /.well-known/agent-card.json   A2A 发现（公开，tsm.* 能力目录）
#   POST /a2a                           A2A JSON-RPC（message/send / tasks/get / tasks/cancel）
#   GET  /peer/health  ·  POST /peer/invoke / /peer/relay
# 凭据必须与 Lume 侧（PEER_ROOT / PEER_SHARED）同值，否则签名对不上、对端回 401。
# 节点注册表缺省读 <data_dir>/peers-identity.json（与 Lume 节点同路径惯例，
# 两侧可用同一份文件）。

# 本节点名（出站签名自称；缺省 "tsm-hub"）
TSM_HUB_PEER_NAME=tsm-hub
# 按节点派生密钥模式（推荐，防冒充）：与 Lume 的 PEER_ROOT 同值
TSM_HUB_PEER_ROOT=change-me-peer-root
# 共享密钥模式（向后兼容，无法防冒充）：与 Lume 的 PEER_SHARED 同值
# TSM_HUB_PEER_SHARED=
# 节点注册表文件（{"peers":["crm","scanner","tsm-hub"]}；缺省 <data_dir>/peers-identity.json）
# TSM_HUB_PEER_REGISTRY=./data/peers-identity.json
# 时间窗（秒，缺省 120）
# TSM_HUB_PEER_SKEW=120
# 绑定 0.0.0.0 / 非回环时，Agent Card 里宣告的对外地址（缺省取监听地址；
# 绑 0.0.0.0 时自动回落 127.0.0.1，跨机部署必须设这个）
# TSM_HUB_A2A_PUBLIC_URL=http://192.168.1.50:9070

# ===== 兼容旧前缀（不推荐，仅用于迁移） =====
# LLM_ROUTER_ADDR=:9070
# LLM_ROUTER_ADMIN_TOKEN=your-admin-token
